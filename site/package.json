{
  "name": "paper-loop-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-pdf-worker.mjs && next dev --hostname 0.0.0.0",
    "build": "node scripts/copy-pdf-worker.mjs && next build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "katex": "0.19.0",
    "next": "16.4.2",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "katex": "$katex"
  },
  "engines": {
    "node": "24.x"
  }
}
